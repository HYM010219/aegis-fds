# 이 파일을 복사해 .env를 만들고 실제 값을 넣는다. .env는 Git에 올리지 않는다.
# MongoDB 접속 주소 (복제 세트 rs0)
MONGO_URI=mongodb://<호스트>:27017/?replicaSet=rs0
GATEWAY_API_KEY = GATEWAY_API_KEY
CLICKHOUSE_PASSWORD = CLICKHOUSE_PASSWORD
# 직원 API(수동 동결·이상 없음·동결 해제) 키. 관제 웹 백엔드에만 알려 준다. 비우면 직원 API가 꺼진다.
ADMIN_API_KEY = ADMIN_API_KEY