# 이 파일을 복사해 .env를 만들고 실제 값을 넣는다. .env는 Git에 올리지 않는다.
# 주의: systemd EnvironmentFile은 KEY=값 # 설명 처럼 줄 끝 주석을 값의 일부로 처리하므로, 주석은 반드시 별도 줄에만 작성한다.

# MongoDB 접속 주소 (도커 내부 네트워크 컨테이너명 mongo 참조)
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0

# 게이트웨이 인증 API 키 (게이트웨이 및 수집기 공통 참조)
GATEWAY_API_KEY=YOUR_GATEWAY_API_KEY

# ClickHouse DB 비밀번호
CLICKHOUSE_PASSWORD=YOUR_CLICKHOUSE_PASSWORD

# 직원 관리자 API 키 (비우면 관리자 API 비활성화)
ADMIN_API_KEY=YOUR_ADMIN_API_KEY

# 관제 콘솔(/admin) Nginx HTTP Basic Auth 비밀번호 (반드시 안전한 비밀번호로 변경)
ADMIN_CONSOLE_PASSWORD=YOUR_ADMIN_CONSOLE_PASSWORD

# 수집기 기본 전송 대상 (게이트웨이 컨테이너 노출 포트)
FASTAPI_URL=http://localhost:8000/api/v1/transfers

# Alchemy 온체인 수집기 WebSocket 엔드포인트 (현재 활성 키)
ALCHEMY_WSS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_1

# 48h 침지 테스트 키 로테이션 (일 00:00 ~ 23:30 전용 Key 1, 30M CU)
ALCHEMY_KEY_1=YOUR_ALCHEMY_KEY_1

# 48h 침지 테스트 키 로테이션 (일 23:30 ~ 화 00:00 전용 Key 2, 30M CU)
ALCHEMY_KEY_2=YOUR_ALCHEMY_KEY_2

# 백업 키 3
ALCHEMY_KEY_3=YOUR_ALCHEMY_KEY_3

# 백업 키 4
ALCHEMY_KEY_4=YOUR_ALCHEMY_KEY_4
